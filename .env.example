# ==============================================================================
# UK Wind Power Forecast & Day-Ahead Procurement Analytics - Environment Config
# ==============================================================================

# Backend API Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api

# Official Elexon Insights Solution (BMRS API)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Procurement Decision Cutoff Setting
# 11:00 UK local time (Europe/London) represents EPEX SPOT & Nord Pool Day-Ahead auction gate closure on D-1
DEFAULT_DECISION_CUTOFF=11:00

# Cache Expiration (seconds)
CACHE_TTL_SECONDS=3600

# Fallback Flag (allows labeled illustrative demo mode if Elexon API is offline/unreachable)
ALLOW_DEMO_FALLBACK=true

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000", "*"]

# Frontend Configuration (for Vite)
# Local development: http://localhost:8000/api
# Docker / Production: /api or https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:8000/api
